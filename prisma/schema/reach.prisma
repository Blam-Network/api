model reach_player_data {
  player_xuid               Decimal  @db.Decimal(20, 0)   @id
  hopper_access             Int?     @default(0)
  hopper_directory_override String?  @db.VarChar(32)
  is_whitelisted            Boolean  @default(false)
  is_vip                    Boolean  @default(false)
  is_bungie                 Boolean  @default(false)
  is_pro                    Boolean  @default(false)
  has_blue_flames           Boolean  @default(false)
  extras_portal_debug       Boolean  @default(false)
  nameplate                 reach_player_data_nameplate @default(none)

  @@map("player_data")
  @@schema("reach")
}

enum reach_player_data_nameplate {
  none
  seventh_column
  dmr
  bungie
  marathon
  halo1
  halo2
  halo3
  odst
  assault_rifle
  mk4_helmet
  halo
  allstar

  @@schema("reach")
}