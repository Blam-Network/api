model reach_player_data {
  player_xuid               Decimal  @db.Decimal(20, 0)   @id
  hopper_access             Int?     @default(0)
  hopper_directory_override String?  @db.VarChar(32)
  is_whitelisted            Boolean  @default(false)
  is_vip                    Boolean  @default(false)

  @@map("player_data")
  @@schema("reach")
}
