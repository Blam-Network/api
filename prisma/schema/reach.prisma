model reach_player_rewards_armour {
  player_xuid                       Decimal                 @db.Decimal(20, 0)
  armour                            reach_armour

  purchased                         Boolean                 @default(false)
  forced_visible_and_purchasable    Boolean                 @default(false)
  bypassed                          Boolean                 @default(false)
  granted_by_lsp                    Boolean                 @default(false)
  banned                            Boolean                 @default(false)

  @@id([player_xuid, armour])
  @@index([player_xuid])
  @@map("player_rewards_armour")
  @@schema("reach")
}
