{
  "name": "sunrise-webserver",
  "version": "2.0.0",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "prisma generate && node --max-old-space-size=4096 ./node_modules/@nestjs/cli/bin/nest.js build",
    "build:docker": "docker build -t sunrise-webserver .",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "NODE_OPTIONS='--max-old-space-size=4096' nest start",
    "start:dev": "prisma generate && nest start --watch",
    "start:debug": "prisma generate && nest start --debug --watch",
    "start:prod": "NODE_OPTIONS='--max-old-space-size=4096' node dist/main",
    "start:docker": "docker compose up",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "migrate": "node ./dist/src/infrastructure/persistance/scripts/migrate.js",
    "seed": "node ./dist/src/infrastructure/persistance/scripts/seed.js"
  },
  "prisma": {
    "schema": "prisma/schema"
  },
  "dependencies": {
    "@blam-network/blf_lsp": "^1.10.10",
    "@blamnetwork/blf": "^1.1.0-alpha.1",
    "@craftycodie/cstruct": "^1.1.1",
    "@faker-js/faker": "^8.4.1",
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/cqrs": "^11.0.3",
    "@nestjs/mongoose": "^11.0.3",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/sequelize": "^11.0.0",
    "@nestjs/serve-static": "^5.0.3",
    "@nestjs/swagger": "^11.2.0",
    "@prisma/client": "^6.7.0",
    "@sequelize/core": "^7.0.0-alpha.10",
    "@types/seedrandom": "^3.0.8",
    "@types/uuid": "^8.3.4",
    "@types/xxhashjs": "^0.2.4",
    "@types/yauzl": "^2.10.3",
    "axios": "^1.9.0",
    "date-fns": "^4.1.0",
    "dedent": "^1.6.0",
    "dotenv": "^16.0.1",
    "geoip-lite": "^1.4.10",
    "mysql2": "^3.14.1",
    "next-auth": "^4.24.13",
    "npm": "^11.6.2",
    "pako": "^2.0.4",
    "reflect-metadata": "^0.1.13",
    "rimraf": "^3.0.2",
    "rxjs": "^7.2.0",
    "seedrandom": "^3.0.5",
    "sequelize": "^6.21.3",
    "sequelize-cli": "^6.4.1",
    "sequelize-typescript": "^2.1.3",
    "sharp": "^0.34.3",
    "tiny-types": "^1.18.4",
    "uuid": "^8.3.2",
    "ws": "^8.18.0",
    "xxhashjs": "^0.2.2",
    "yauzl": "^3.2.0",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.7",
    "@nestjs/schematics": "^9.0.0",
    "@nestjs/testing": "^11.1.0",
    "@types/express": "^4.17.13",
    "@types/jest": "28.1.4",
    "@types/multer": "^1.4.7",
    "@types/node": "^16.11.47",
    "@types/pako": "^2.0.0",
    "@types/sequelize": "^4.28.14",
    "@types/supertest": "^2.0.11",
    "@typescript-eslint/eslint-plugin": "^5.0.0",
    "@typescript-eslint/parser": "^5.0.0",
    "eslint": "^8.0.1",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-prettier": "^4.0.0",
    "jest": "28.1.2",
    "prettier": "^2.3.2",
    "prisma": "^6.7.0",
    "source-map-support": "^0.5.20",
    "supertest": "^6.1.3",
    "ts-jest": "28.0.5",
    "ts-loader": "^9.2.3",
    "ts-node": "^10.0.0",
    "tsconfig-paths": "4.0.0",
    "typescript": "^5.1.5"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "./",
    "roots": [
      "<rootDir>"
    ],
    "modulePaths": [
      "<rootDir>"
    ],
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
