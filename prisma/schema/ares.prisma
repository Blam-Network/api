model ares_player_data {
  player_xuid               Decimal  @id @db.Decimal(20, 0)
  hopper_access             Int?     @default(0)
  highest_skill             Int?     @default(0)
  is_bungie                 Boolean? @default(false)
  is_pro                    Boolean? @default(false)
  has_recon                 Boolean? @default(false)
  hopper_directory_override String?  @db.VarChar(32)

  @@map("player_data")
  @@schema("ares")
}

model ares_file_share {
  share_id          Decimal @id @db.Decimal(20, 0)
  quota_slots       Int?    @db.SmallInt
  quota_bytes       Int?
  message           String?
  lastHash          Int     @default(0)
  unsubscribe_stage Int?    @db.SmallInt

  @@map("file_share")
  @@schema("ares")
}

model ares_file_share_file {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  share_id    Decimal @db.Decimal(20, 0)
  slot        Int     @db.SmallInt
  is_uploaded Boolean @default(false)

  compressed_size Int

  unique_id                 Decimal                     @db.Decimal(20, 0)
  name                      String?                     @db.VarChar(16)
  description               String?                     @db.VarChar(128)
  author                    String?                     @db.VarChar(16)
  file_type                 Int
  author_is_xuid_online     Boolean?
  author_id                 Decimal?                    @db.Decimal(20, 0)
  size_in_bytes             Decimal                     @db.Decimal(20, 0)
  date                      DateTime?                   @db.Timestamp(6)
  length_seconds            Int?
  map_id                    Int?
  game_engine_type          Int?
  campaign_id               Int?
  campaign_difficulty       Int?
  campaign_insertion_point  Int?                        @db.SmallInt
  hopper_id                 Int?                        @db.SmallInt
  game_id                   Decimal?                    @db.Decimal(20, 0)
  ares_file_share_transfer  ares_file_share_transfer[]

  @@unique([share_id, slot], map: "unique_share_id_slot")
  @@map("file_share_slot")
  @@schema("ares")
}

model ares_blind_screenshot {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
