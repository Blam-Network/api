model halo3_blind_screenshot {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  unique_id             Decimal? @db.Decimal(20, 0)
  name                  String   @db.VarChar(16)
  description           String   @db.VarChar(128)
  author                String   @db.VarChar(16)
  file_type             Int
  author_is_xuid_online Boolean
  author_id             Decimal  @db.Decimal(20, 0)
  size_in_bytes         Decimal  @db.Decimal(20, 0)
  date                  DateTime @db.Timestamp(6)
  length_seconds        Int
  campaign_id           Int
  map_id                Int
  game_engine_type      Int
  campaign_difficulty   Int
  hopper_id             Int      @db.SmallInt
  game_id               Decimal  @db.Decimal(20, 0)
  game_tick             Int?
  film_tick             Int?
  jpeg_length           Int?
  camera_position       Float[]
  pixel_width           Int?      @db.SmallInt
  pixel_height          Int?      @db.SmallInt

  @@unique([unique_id, date, game_id], map: "unique_unique_id_date")
  @@map("blind_screenshot")
  @@schema("halo3")
}

model halo3_carnage_report {
  id                                 String                                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  team_game                          Boolean
  game_id                            Decimal                                   @db.Decimal(20, 0)
  map_id                             Int
  scenario_path                      String
  map_variant_name                   String                                    @db.VarChar(32)
  game_variant_unique_id             Decimal                                   @db.Decimal(20, 0)
  map_variant_unique_id              Decimal                                   @db.Decimal(20, 0)
  started                            Boolean
  start_time                         DateTime                                  @db.Timestamp(6)
  finished                           Boolean
  finish_time                        DateTime                                  @db.Timestamp(6)
  migrated_to_group                  Boolean
  migrated_solo                      Boolean
  simulation_aborted                 Boolean
  in_group_session                   Boolean                                   @default(false)
  in_squad_session                   Boolean                                   @default(false)
  carnage_report_event_carry         halo3_carnage_report_event_carry[]
  carnage_report_event_kill          halo3_carnage_report_event_kill[]
  carnage_report_event_score         halo3_carnage_report_event_score[]
  carnage_report_game_variant        halo3_carnage_report_game_variant?
  carnage_report_machine             halo3_carnage_report_machine[]
  carnage_report_matchmaking_options halo3_carnage_report_matchmaking_options?
  carnage_report_player              halo3_carnage_report_player[]
  carnage_report_player_medals       halo3_carnage_report_player_medals[]
  carnage_report_team                halo3_carnage_report_team[]

  @@unique([start_time, map_id, game_id], map: "unique_start_map_game")
  @@index([start_time], map: "idx_carnage_report_start_time")
  @@map("carnage_report")
  @@schema("halo3")
}

model halo3_carnage_report_event_carry {
  id                    String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  carnage_report_id     String?                      @db.Uuid
  time                  Decimal                      @db.Decimal(20, 0)
  carry_player_index    Int                          @db.SmallInt
  position              Float[]
  weapon_index          Int
  carry_type            Int
  carnage_report_player halo3_carnage_report_player? @relation(fields: [carnage_report_id, carry_player_index], references: [carnage_report_id, player_index], onDelete: Cascade, onUpdate: NoAction)
  carnage_report        halo3_carnage_report?        @relation(fields: [carnage_report_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("carnage_report_event_carry")
  @@schema("halo3")
}

