model reach_player_data {
  player_xuid               Decimal                     @id @db.Decimal(20, 0)
  hopper_access             Int?                        @default(0)
  hopper_directory_override String?                     @db.VarChar(32)
  is_whitelisted            Boolean                     @default(false)
  is_vip                    Boolean                     @default(false)
  is_bungie                 Boolean                     @default(false)
  is_pro                    Boolean                     @default(false)
  extras_portal_debug       Boolean                     @default(false)
  nameplate                 reach_player_data_nameplate @default(none)

  @@map("player_data")
  @@schema("reach")
}

enum reach_player_data_nameplate {
  none
  seventh_column
  dmr
  bungie
  marathon
  halo1
  halo2
  halo3
  odst
  assault_rifle
  mk4_helmet
  halo
  allstar

  @@schema("reach")
}

model reach_blind_screenshot {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  unique_id             Decimal? @db.Decimal(20, 0)
  parent_unique_id      Decimal? @db.Decimal(20, 0)
  root_unique_id        Decimal? @db.Decimal(20, 0)
  name                  String   @db.VarChar(16)
  description           String   @db.VarChar(128)
  author                String   @db.VarChar(16)
  file_type             Int
  activity              Int
  author_is_xuid_online Boolean
  author_id             Decimal  @db.Decimal(20, 0)
  size_in_bytes         Decimal  @db.Decimal(20, 0)
  date                  DateTime @db.Timestamp(6)
  length_seconds        Int?
  campaign_id           Int?
  map_id                Int
  game_mode             Int
  game_engine_type      Int
  difficulty            Int?
  hopper_id             Int?     @db.SmallInt
  game_id               Decimal  @db.Decimal(20, 0)
  jpeg_length           Int
  build_number          Int

  @@unique([unique_id, date, game_id], map: "unique_unique_id_date")
  @@map("blind_screenshot")
  @@schema("reach")
}

model reach_player_rewards {
  player_xuid               Decimal                     @id @db.Decimal(20, 0)
  credits                   Int                         @default(0)
  credits_award             Int?                        @default(0)
  reset_rewards             Boolean                     @default(false)

  updatedAt                 DateTime                    @updatedAt

  @@map("player_rewards")
  @@schema("reach")
}

