generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["public", "halo3", "odst", "reach", "ares"]
}

enum DatamineParameterType {
  LONG
  INT64
  FLOAT
  STRING

  @@schema("public")
}

model datamine_session {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  sessionid          String           @db.VarChar(128)
  build_string       String           @db.VarChar(32)
  build_number       Int
  systemid           String           @db.VarChar(160)
  title              String           @db.VarChar(32)
  session_start_date DateTime
  events             datamine_event[]

  @@unique([sessionid, session_start_date])
  @@schema("public")
}

model datamine_event {
  event_index Int
  session_id  String           @db.Uuid
  session     datamine_session @relation(fields: [session_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  priority      Int
  categories    String[]
  game_instance Decimal  @db.Decimal(20, 0)
  map           String   @db.VarChar(260)
  event_date    DateTime

  message    String                     @db.VarChar(2048)
  parameters datamine_event_parameter[]

  @@id([event_index, session_id])
  @@schema("public")
}

model datamine_event_parameter {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  event_index Int
  session_id  String         @db.Uuid
  event       datamine_event @relation(fields: [event_index, session_id], references: [event_index, session_id], onDelete: Cascade, onUpdate: NoAction)

  key           String                @db.VarChar(128)
  type          DatamineParameterType
  numeric_value Decimal?              @db.Decimal(30, 10) // Large enough for int64 and float with precision
  string_value  String

  @@index([event_index, session_id])
  @@index([key])
  @@schema("public")
}

model bnet_user {
  player_xuid     Decimal @id @db.Decimal(20, 0)
  is_registered   Boolean @default(false)
  datamine_access Boolean @default(false)
  is_admin        Boolean @default(false)
  is_uploader     Boolean @default(false)

  @@schema("public")
}
